generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String?
  location            String?
  bio                 String?
  avatarUrl           String?
  rating              Float                @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accounts            Account[]
  buyerConversations  Conversation[]       @relation("BuyerConversations")
  sellerConversations Conversation[]       @relation("SellerConversations")
  items               Item[]               @relation("SellerItems")
  sentMessages        Message[]            @relation("SentMessages")
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  items Item[]

  @@map("categories")
}

model Item {
  id            String         @id @default(cuid())
  title         String
  description   String
  price         Decimal?       @db.Decimal(10, 2)
  type          ItemType
  condition     ItemCondition
  status        ItemStatus     @default(ATIVO)
  location      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sellerId      String
  categoryId    String
  conversations Conversation[]
  images        ItemImage[]
  category      Category       @relation(fields: [categoryId], references: [id])
  seller        User           @relation("SellerItems", fields: [sellerId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([categoryId])
  @@index([sellerId])
  @@map("items")
}

model ItemImage {
  id       String @id @default(cuid())
  url      String
  position Int    @default(0)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_images")
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  itemId    String?
  item      Item?    @relation(fields: [itemId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  itemId    String
  buyerId   String
  sellerId  String
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  seller    User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([itemId, buyerId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  content        String
  createdAt      DateTime     @default(now())
  conversationId String
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

enum ItemType {
  VENDA
  TROCA
  DOACAO
}

enum ItemCondition {
  NOVO
  USADO_COMO_NOVO
  USADO_BOM_ESTADO
  USADO_ESTADO_REGULAR
}

enum ItemStatus {
  ATIVO
  RESERVADO
  CONCLUIDO
  INATIVO
}
