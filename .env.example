# Banco e sessão
DATABASE_URL="postgresql://reuse:reuse@localhost:5432/reuse?schema=public"
# Use uma chave aleatória e estável com pelo menos 32 caracteres em cada ambiente.
SESSION_SECRET="troque-por-uma-chave-longa-e-aleatoria"
ASSISTANT_CONFIRMATION_SECRET=""
# Origem pública canônica. Em produção, não use localhost nem uma URL de preview.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SEED_PASSWORD=""
DEMO_SEED_ALLOWED="false"

# Login social (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Recuperação de senha (opcional)
RESEND_API_KEY=""
# Em produção, use um remetente de domínio verificado no Resend.
RESEND_FROM_EMAIL=""

# IBM Watson Assistant (opcional no desenvolvimento)
IBM_WATSON_API_KEY=""
IBM_WATSON_ASSISTANT_ID=""
IBM_WATSON_SERVICE_URL=""
IBM_WATSON_API_VERSION="2024-08-25"

# Ferramentas do web chat oficial da IBM
ASSISTANT_API_KEY=""

# watsonx Orchestrate (opcional no desenvolvimento — ver watsonx-orchestrate/README.md)
ORCHESTRATE_APIKEY=""
ORCHESTRATE_CHAT_URL=""
ORCHESTRATE_AGENT_ID=""
ORCHESTRATE_TOOLS_SECRET=""

# Mostra os assistentes antigos (AssistantWidget e o painel ReuseAssistant no
# perfil) junto com o web chat oficial da IBM. Padrão: escondidos ("false").
NEXT_PUBLIC_SHOW_LEGACY_ASSISTANTS="false"

# Supabase Storage — obrigatório para uploads persistentes em produção
# A implementação atual espera a chave JWT legada `service_role`.
# Não use uma chave `sb_secret_...` sem adaptar e validar os headers em src/lib/uploads.js.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="reuse-items"
